---
import Logo from "../ui/Logo.astro";
---

<footer class="footer" id="footer">
    <div class="footer-container">
        
        <!-- Obere Sektion: Branding und Navigation -->
        <div class="footer-top">
            <section class="footer-brand">
                <div class="footer-logo-wrapper">
                    <Logo variant="white" />
                </div>
                <!-- Open-Source-Hinweis -->
                <div class="footer-oss-box">
                    <p class="oss-text">
                        Diese Website ist Open Source. <br />
                        Hier geht's zum <a href="https://github.com/lucasfreyarbeit/portfolio-webseite" class="oss-link">Quellcode</a>.
                    </p>
                </div>
            </section>

            <section class="footer-links" aria-label="Footer Navigation">
                <nav class="link-column" aria-label="Projekte">
                    <span class="column-title">Projekte</span>
                    <a href="https://github.com/lucasfreyarbeit" class="link-text">GitHub</a>
                    <a href="https://lucasfreyarbeit.itch.io/"class="link-text">Itch.io</a>
                </nav>

                <nav class="link-column" aria-label="Social Media">
                    <span class="column-title">Socials</span>
                    <a href="https://discord.com/users/1394404456971374701"class="link-text">Discord</a>
                    <a href="https://dev.to/lucasfrey"class="link-text">Dev.to</a>
                </nav>
            </section>
        </div>

        <!-- Integrierter Divider -->
        <div class="footer-divider"></div>

        <!-- Untere Sektion: Meta-Links und Copyright -->
        <div class="footer-bottom">
            <p class="copyright">© 2026 Lucas Frey. Alle Rechte vorbehalten.</p>
            
            <div id="footer-backup-slot"></div>

            <nav class="footer-bottom-right" aria-label="Rechtliche Hinweise">
                <a href="/info/impressum">Impressum</a>
                <a href="/info/datenschutz">Datenschutz</a>
                <a href="/info/barrierefreiheit">Barrierefreiheit</a>
            </nav>
        </div>

    </div>
</footer>

<style>
    * {
        box-sizing: border-box;
    }

    /* Layout & Basiskonfiguration */
    .footer {
        /* Zuweisung der Standardschriftart für den gesamten Footer */
        font-family: var(--font-normal, sans-serif);
        width: 100vw; 
        position: relative;
        left: 50%;
        transform: translateX(-50%);
        margin-top: auto;
        padding: 5rem 0 0 0; 
        background: var(--footer-color);
        color: #e3e3e3;
        filter: none !important;
    }

    .footer-container {
        display: flex;
        flex-direction: column;
        gap: 1rem; 
        width: 100%; 
        margin: 0 auto; 
        padding: 0 1.5rem; 
    }

    .footer-top {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        justify-content: space-between;
        gap: 2.5rem;
        margin-bottom: 0.5rem;
    }

    /* Branding & Logo-Skalierung */
    .footer-brand {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 1.75rem; 
        max-width: 500px;
    }

    .footer-logo-wrapper {
        transform: scale(3.5);
        margin-bottom: 1rem; 
        transform-origin: left center;
    }

    .footer-oss-box {
        width: 100%;
    }

    .oss-text {
        margin: 0;
        font-size: 1.5rem;
        line-height: 1.5;
        color: #a3a3a3; 
    }

    .oss-link {
        color: #e7e7e7 !important;
        font-weight: 600;
    }

    /* Navigation Spalten */
    .footer-links {
        text-align: center;
        display: flex;
        gap: 5rem;
    }

    .link-column {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .link-text {
        font-size: 1.5rem;
    }

    .column-title {
        margin-bottom: 0.25rem;
        font-family: var(--font-heading, monospace);
        font-size: 1.5rem;
        font-weight: bold;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        opacity: 0.4;
    }

    /* Interaktions-Zustände der Links */
    .footer a {
        color: inherit;
        text-decoration: none;
        transition: color 0.25s ease, font-weight 0.25s ease, text-shadow 0.25s ease;
    }

    .footer a:hover {
        color: var(--footer-hover-color) !important;
        font-weight: 700;
        text-shadow: 0 0 10px var(--footer-hover-color);
    }

    /* Integrierter Divider */
    .footer-divider {
        display: block;
        width: 100%;
        height: 2px;
        background-color: rgb(26, 26, 26);
        margin: 1rem 0 0 0;
    }

    /* Footer-Bottom */
    .footer-bottom {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 2.5rem;
        padding: 0.5rem 0 0 0; 
        font-size: 1.25rem;
        margin-bottom: 0;
    }

    .copyright {
        margin: 0;
        padding-bottom: 0.75rem; 
        color: #a3a3a3;
        font-size: 1.25rem;
    }

    #footer-backup-slot {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .footer-bottom-right {
        display: flex;
        gap: 1.5rem;
        padding-bottom: 0.75rem; 
    }

    .footer-bottom-right a {
        color: #a3a3a3;
    }

    /* Responsive Anpassungen (Mobile Viewport) */
    @media (max-width: 768px) {
        .footer {
            padding: 4rem 0 0 0;
        }
        
        .footer-container {
            padding: 0 1rem; 
            gap: 1rem;
        }

        .footer-top {
            flex-direction: column;
            gap: 2.5rem;
        }

        .footer-links {
            gap: 3rem;
        }

        .footer-bottom {
            flex-direction: column;
            align-items: center;
            gap: 1rem;
            padding-top: 0.5rem;
            padding-bottom: 1rem; 
        }

        .copyright, .footer-bottom-right {
            padding-bottom: 0;
        }

        #footer-backup-slot {
            position: static;
            transform: none;
        }
    }
</style>