---
// Komponente zur visuellen Überprüfung aller eingebundenen Schriftarten.
// Vollständig bereinigt um verbleibende Tailwind-Konflikte.
---

<section class="mx-auto flex max-w-4xl flex-col gap-6 p-8">
  <h2>TYPOGRAFIE & FONT TEST</h2>

  <!-- 1. Inter Test (Variable Font) -->
  <div class="border-border-color bg-bg-color rounded-lg border p-6">
    <h3 class="border-border-color mb-4 border-b pb-2">
      Inter (Variable Font)
    </h3>
    <p class="font-thin">
      Inter Thin (100) — The quick brown fox jumps over the lazy dog.
    </p>
    <p class="font-light">
      Inter Light (300) — The quick brown fox jumps over the lazy dog.
    </p>
    <!-- font-normal entfernt, da Inter standardmäßig als Basis-Schriftart im Body definiert ist -->
    <p>Inter Regular (400) — The quick brown fox jumps over the lazy dog.</p>
    <p class="font-medium">
      Inter Medium (500) — The quick brown fox jumps over the lazy dog.
    </p>
    <p class="font-bold">
      Inter Bold (700) — The quick brown fox jumps over the lazy dog.
    </p>
    <p class="font-black">
      Inter Black (900) — The quick brown fox jumps over the lazy dog.
    </p>
    <p class="italic">
      Inter Italic (400 Italic) — The quick brown fox jumps over the lazy dog.
    </p>
    <p class="font-bold italic">
      Inter Bold Italic (700 Italic) — The quick brown fox jumps over the lazy
      dog.
    </p>
  </div>

  <!-- 2. JetBrains Mono Test (Variable Font) -->
  <div class="border-border-color bg-bg-color rounded-lg border p-6">
    <h3 class="border-border-color mb-4 border-b pb-2">
      JetBrains Mono (Variable Font)
    </h3>
    <!-- font-normal / font-light entfernt, da font-heading bereits die primäre Font-Family vorgibt -->
    <p class="font-heading font-light">
      JetBrains Mono Light (300) — const fn = () =&gt; "Hello World";
    </p>
    <p class="font-heading">
      JetBrains Mono Regular (400) — const fn = () =&gt; "Hello World";
    </p>
    <p class="font-heading font-semibold">
      JetBrains Mono Semibold (600) — const fn = () =&gt; "Hello World";
    </p>
    <p class="font-heading font-bold">
      JetBrains Mono Bold (700) — const fn = () =&gt; "Hello World";
    </p>
    <p class="font-heading font-extrabold">
      JetBrains Mono ExtraBold (800) — const fn = () =&gt; "Hello World";
    </p>
  </div>

  <!-- 3. OpenDyslexic Test (Statisch) -->
  <div class="border-border-color bg-bg-color rounded-lg border p-6">
    <h3 class="border-border-color mb-4 border-b pb-2">OpenDyslexic</h3>
    <!-- font-normal entfernt, da Standard-Gewichtung bei Anwendung von font-dyslexic greift -->
    <p class="font-dyslexic">
      OpenDyslexic Regular (400) — Barrierefreier Text für bessere Lesbarkeit.
    </p>
    <p class="font-dyslexic font-bold">
      OpenDyslexic Bold (700) — Barrierefreier Text für bessere Lesbarkeit.
    </p>
  </div>

  <!-- 4. Globale Headings Test -->
  <div class="border-border-color bg-bg-color rounded-lg border p-6">
    <h3 class="border-border-color mb-4 border-b pb-2">
      HTML Headings (Gesteuert durch global.css)
    </h3>
    <h1>H1 Heading (2.5rem - JetBrains Mono Bold)</h1>
    <h2>H2 Heading (2.0rem - JetBrains Mono Bold)</h2>
    <h3>H3 Heading (1.75rem - JetBrains Mono Semibold)</h3>
    <h4>H4 Heading (1.5rem - JetBrains Mono Semibold)</h4>
    <h5>H5 Heading (1.25rem - JetBrains Mono Medium)</h5>
    <h6>H6 Heading (1.0rem - JetBrains Mono Medium)</h6>
  </div>
</section>
