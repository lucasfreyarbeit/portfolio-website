---
// @ts-ignore - Verhindert Svelte-Constructor-Mismatch im Type-Checker
import Typewriter from "../animations/Typewriter.svelte";

const {
    href = "#hero",
    text = "LUCAS.FREY",
    variant = "black",
    speed = 100,
    delay = 0,
    cursorChar = "_",
    class: className = "",
} = Astro.props;
---

<a
    href={href}
    class:list={["logo", `logo--${variant}`, className]}
>
    <!-- Astro verknüpft das client:load jetzt wieder direkt mit dem Import -->
    <Typewriter 
        client:load 
        text={text} 
        speed={speed} 
        delay={delay} 
        cursorChar={cursorChar} 
    />
</a>

<style>
/* Basis-Styling des Logos */
.logo {
    display: inline-block;

    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    text-decoration: none;
    line-height: 1;

    transition: color 0.15s ease-out;
}

/* Farbvarianten */
.logo--black {
    color: var(--text-color);
}

.logo--white {
    color: var(--color-white, #ffffff);
}

/* Tastatur-Fokus für Accessibility */
.logo:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
}
</style>